# Copy to .env on the QA host and replace every REPLACE_ME value. Never commit .env.
IDENTIPAT_IMAGE=ghcr.io/elvisman2/identipat-ia@sha256:REPLACE_ME
PREPROCESSING_IMAGE=ghcr.io/elvisman2/identipat-preprocessing@sha256:REPLACE_ME
DB_NAME=identipatdb
DB_USER=REPLACE_ME
DB_PASSWORD=REPLACE_ME
IDENTIPAT_AI_ENABLED=true
IDENTIPAT_AI_PROVIDER=openai
OPENAI_API_KEY=REPLACE_ME
OPENAI_MODEL=REPLACE_ME
OPENAI_TIMEOUT=60s
JWT_SECRET=REPLACE_ME_AT_LEAST_32_RANDOM_CHARACTERS
STANDARD_SESSION_PEPPER=REPLACE_ME_BASE64_RANDOM_VALUE
CORS_ALLOWED_ORIGINS=https://REPLACE_ME
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8082
APP_MEMORY_LIMIT=768m
APP_CPU_LIMIT=0.75
ANALYSIS_WORKER_THREADS=1
ANALYSIS_WORKER_QUEUE_CAPACITY=1
PREPROCESSING_LOG_LEVEL=INFO
PREPROCESSING_PDF_MAX_FILE_SIZE_BYTES=10485760
PREPROCESSING_PDF_MAX_PAGES=50
PREPROCESSING_AUDIO_MAX_FILE_SIZE_BYTES=20971520
PREPROCESSING_AUDIO_MAX_DURATION_SECONDS=180
PREPROCESSING_AUDIO_MODEL=base
PREPROCESSING_AUDIO_LANGUAGE=es
PREPROCESSING_AUDIO_DEVICE=cpu
PREPROCESSING_AUDIO_COMPUTE_TYPE=int8
PREPROCESSING_MEMORY_LIMIT=640m
PREPROCESSING_CPU_LIMIT=0.50
