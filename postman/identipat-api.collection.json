{
  "info": {
    "_postman_id": "f06a0ec4-28a7-4f0d-bcf8-9b3c901c0f60",
    "name": "IDENTIPAT-IA API",
    "description": "Colección alineada con el contrato OpenAPI actual. Configure valores locales antes de ejecutar las solicitudes que escriben o administran usuarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8082/identipat-ia" },
    { "key": "adminDoi", "value": "ADMIN_DOI_PLACEHOLDER" },
    { "key": "adminPassword", "value": "" },
    { "key": "adminJwt", "value": "" },
    { "key": "standardDoi", "value": "00000000" },
    { "key": "standardDoiType", "value": "DNI" },
    { "key": "adminUserId", "value": "1" },
    { "key": "csrfToken", "value": "" },
    { "key": "consentVersion", "value": "personal-data/1.0" },
    { "key": "analysisId", "value": "" }
  ],
  "item": [
    {
      "name": "Public - Standard",
      "item": [
        {
          "name": "Recognize document",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doi\": \"{{standardDoi}}\",\n  \"doiType\": \"{{standardDoiType}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/users/identify",
            "description": "Público. Solo devuelve registered; no autentica ni expone PII."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Recognition is successful', function () { pm.response.to.have.status(200); });",
                "const body = pm.response.json();",
                "pm.test('Recognition exposes only registered', function () { pm.expect(Object.keys(body)).to.eql(['registered']); });"
              ]
            }
          }]
        },
        {
          "name": "Register STANDARD",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Nombre de prueba\",\n  \"paternalLastName\": \"Apellido paterno\",\n  \"maternalLastName\": \"Apellido materno\",\n  \"doi\": \"{{standardDoi}}\",\n  \"doiType\": \"{{standardDoiType}}\",\n  \"birthDate\": \"01/01/1990\",\n  \"gender\": \"FEMALE\",\n  \"email\": \"standard.placeholder@example.test\",\n  \"phone\": \"016543210\",\n  \"mobilePhone\": \"912345678\",\n  \"profession\": \"Profesión de prueba\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/users",
            "description": "Público. El body coincide con StandardUserRegistrationRequest y no contiene userType, status ni password. Use un DOI de prueba único."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('STANDARD registration is created', function () { pm.response.to.have.status(201); });",
                "const body = pm.response.json();",
                "pm.test('Registration response exposes only registered', function () { pm.expect(Object.keys(body)).to.eql(['registered']); });"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "STANDARD - Session and consent",
      "description": "La cookie HttpOnly IDENTIPAT_STANDARD_SESSION se conserva en el cookie jar. CSRF no autentica y usa XSRF-TOKEN + X-XSRF-TOKEN.",
      "item": [
        {
          "name": "1. Get CSRF and save token",
          "request": { "method": "GET", "auth": { "type": "noauth" }, "url": "{{baseUrl}}/standard-session/csrf" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('CSRF bootstrap succeeds', function () { pm.response.to.have.status(200); });",
            "const body = pm.response.json();",
            "pm.expect(body.headerName).to.eql('X-XSRF-TOKEN');",
            "pm.collectionVariables.set('csrfToken', body.token);"
          ] } }]
        },
        {
          "name": "2. Identify STANDARD",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "noauth" },
            "body": { "mode": "raw", "raw": "{\n  \"doi\": \"{{standardDoi}}\",\n  \"doiType\": \"{{standardDoiType}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/users/identify"
          }
        },
        {
          "name": "3. Register STANDARD if needed",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "noauth" },
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Nombre de prueba\",\n  \"paternalLastName\": \"Apellido\",\n  \"maternalLastName\": \"Prueba\",\n  \"doi\": \"{{standardDoi}}\",\n  \"doiType\": \"{{standardDoiType}}\",\n  \"birthDate\": \"01/01/1990\",\n  \"gender\": \"FEMALE\",\n  \"email\": \"standard.placeholder@example.test\",\n  \"phone\": \"016543210\",\n  \"mobilePhone\": \"912345678\",\n  \"profession\": \"Prueba\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/users",
            "description": "Ejecutar solo si Identify devuelve registered=false. Use datos ficticios y un DOI de prueba."
          }
        },
        {
          "name": "4. Create STANDARD session",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }],
            "auth": { "type": "noauth" },
            "body": { "mode": "raw", "raw": "{\n  \"doi\": \"{{standardDoi}}\",\n  \"doiType\": \"{{standardDoiType}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/standard-sessions",
            "description": "Ejecutar después de Identify/Register. El token de sesión nunca aparece en JSON; Postman conserva la cookie HttpOnly."
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Session is created', function () { pm.response.to.have.status(201); });", "pm.expect(pm.response.json()).not.to.have.property('token');"] } }]
        },
        {
          "name": "5. Get STANDARD session",
          "request": { "method": "GET", "auth": { "type": "noauth" }, "url": "{{baseUrl}}/standard-session" }
        },
        {
          "name": "6. Accept consent",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }],
            "auth": { "type": "noauth" },
            "body": { "mode": "raw", "raw": "{\n  \"consentVersion\": \"{{consentVersion}}\",\n  \"decision\": \"ACCEPTED\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/standard-session/consent"
          }
        },
        {
          "name": "7. Get session after consent",
          "request": { "method": "GET", "auth": { "type": "noauth" }, "url": "{{baseUrl}}/standard-session" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Consent is current', function () { pm.expect(pm.response.json().consentRequired).to.eql(false); });"] } }]
        },
        {
          "name": "8. Close session",
          "request": { "method": "DELETE", "header": [{ "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }], "auth": { "type": "noauth" }, "url": "{{baseUrl}}/standard-session" }
        },
        {
          "name": "9. Reject consent (new-session case)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }],
            "auth": { "type": "noauth" },
            "body": { "mode": "raw", "raw": "{\n  \"consentVersion\": \"{{consentVersion}}\",\n  \"decision\": \"REJECTED\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/standard-session/consent",
            "description": "Caso separado: ejecutar Get CSRF y Create STANDARD session antes de este request. REJECTED cierra la sesión y elimina su cookie."
          }
        },
        {
          "name": "10. Negative - missing CSRF",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "auth": { "type": "noauth" },
            "body": { "mode": "raw", "raw": "{\n  \"doi\": \"{{standardDoi}}\",\n  \"doiType\": \"{{standardDoiType}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/standard-sessions"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Missing CSRF is forbidden', function () { pm.response.to.have.status(403); });"] } }]
        },
        {
          "name": "11. Negative - missing or expired session",
          "request": { "method": "GET", "auth": { "type": "noauth" }, "url": "{{baseUrl}}/standard-session", "description": "Borre IDENTIPAT_STANDARD_SESSION del cookie jar o ejecute después de cierre/rechazo." },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Session is required', function () { pm.response.to.have.status(401); });"] } }]
        },
        {
          "name": "12. Negative - outdated consent version",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }],
            "auth": { "type": "noauth" },
            "body": { "mode": "raw", "raw": "{\n  \"consentVersion\": \"personal-data/obsolete\",\n  \"decision\": \"ACCEPTED\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/standard-session/consent"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Outdated version conflicts', function () { pm.response.to.have.status(409); });"] } }]
        }
      ]
    },
    {
      "name": "STANDARD - Text analysis",
      "description": "Ejecute primero CSRF, sesión y consentimiento ACCEPTED. La creación es asíncrona; GET se ejecuta una vez y no hace polling infinito.",
      "item": [
        {
          "name": "1. Create text analysis and save ID",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }
            ],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"He desarrollado un mecanismo modular que controla el riego según mediciones del suelo.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/analyses/text",
            "description": "Requiere cookie STANDARD vigente, consentimiento aceptado y CSRF. Responde 202 sin esperar al proveedor."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Analysis is accepted asynchronously', function () { pm.response.to.have.status(202); });",
                "pm.expect(pm.response.headers.get('Retry-After')).to.eql('2');",
                "const body = pm.response.json();",
                "if (body.analysisId) { pm.collectionVariables.set('analysisId', body.analysisId); }"
              ]
            }
          }]
        },
        {
          "name": "2. Get text analysis once",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/analyses/{{analysisId}}",
            "description": "No requiere CSRF. Devuelve RECEIVED/ANALYZING/COMPLETED/FAILED únicamente para la misma session_id. Repita manualmente si sigue procesando."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Analysis lookup succeeds', function () { pm.response.to.have.status(200); });",
                "pm.expect(['RECEIVED', 'ANALYZING', 'COMPLETED', 'FAILED']).to.include(pm.response.json().status);",
                "pm.expect(pm.response.json()).not.to.have.property('invocations');"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "Admin - Authentication",
      "item": [{
        "name": "Login ADMIN and save JWT",
        "request": {
          "method": "POST",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "auth": { "type": "noauth" },
          "body": {
            "mode": "raw",
            "raw": "{\n  \"doi\": \"{{adminDoi}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
            "options": { "raw": { "language": "json" } }
          },
          "url": "{{baseUrl}}/users/login",
          "description": "Público sin token previo, pero solo un ADMIN activo recibe JWT. Complete las variables locales sin versionar credenciales."
        },
        "event": [{
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ADMIN login is successful', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('Bearer access token is returned', function () { pm.expect(body.tokenType).to.eql('Bearer'); pm.expect(body.accessToken).to.be.a('string').and.not.empty; });",
              "if (body.accessToken) { pm.collectionVariables.set('adminJwt', body.accessToken); }"
            ]
          }
        }]
      }]
    },
    {
      "name": "Admin - Users",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminJwt}}", "type": "string" }] },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Get user by ID",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminJwt}}", "type": "string" }] },
            "url": "{{baseUrl}}/users/{{adminUserId}}"
          }
        },
        {
          "name": "Get user by DOI",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminJwt}}", "type": "string" }] },
            "url": "{{baseUrl}}/users/doi/{{standardDoi}}"
          }
        },
        {
          "name": "Update user data",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminJwt}}", "type": "string" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Nombre actualizado\",\n  \"paternalLastName\": \"Apellido paterno\",\n  \"maternalLastName\": \"Apellido materno\",\n  \"doi\": \"{{standardDoi}}\",\n  \"doiType\": \"{{standardDoiType}}\",\n  \"birthDate\": \"01/01/1990\",\n  \"gender\": \"FEMALE\",\n  \"email\": \"updated.placeholder@example.test\",\n  \"phone\": \"016543210\",\n  \"mobilePhone\": \"912345678\",\n  \"profession\": \"Profesión actualizada\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/users/{{adminUserId}}"
          }
        },
        {
          "name": "Update user administratively",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminJwt}}", "type": "string" }] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Nombre administrativo\",\n  \"paternalLastName\": \"Apellido paterno\",\n  \"maternalLastName\": \"Apellido materno\",\n  \"doi\": \"{{adminDoi}}\",\n  \"doiType\": \"DNI\",\n  \"birthDate\": \"01/01/1990\",\n  \"gender\": \"FEMALE\",\n  \"email\": \"admin.placeholder@example.test\",\n  \"phone\": \"016543210\",\n  \"mobilePhone\": \"912345678\",\n  \"userType\": \"ADMIN\",\n  \"profession\": \"Administración\",\n  \"status\": \"A\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/users/admin/{{adminUserId}}",
            "description": "La actualización integral de un ADMIN exige una contraseña; complete adminPassword localmente."
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminJwt}}", "type": "string" }] },
            "url": "{{baseUrl}}/users/{{adminUserId}}",
            "description": "Operación destructiva: use solo con un usuario de prueba."
          }
        }
      ]
    },
    {
      "name": "Security - Negative",
      "item": [
        {
          "name": "Admin endpoint without JWT",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/users"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('JWT is required for administrative listing', function () { pm.response.to.have.status(401); });"]
            }
          }]
        },
        {
          "name": "STANDARD login is rejected",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doi\": \"{{standardDoi}}\",\n  \"password\": \"not-a-standard-credential\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/users/login",
            "description": "Precondición: standardDoi debe corresponder a un STANDARD registrado."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('STANDARD users do not receive JWT', function () { pm.response.to.have.status(401); });",
                "pm.test('No access token is exposed', function () { pm.expect(pm.response.json()).not.to.have.property('accessToken'); });"
              ]
            }
          }]
        },
        {
          "name": "Duplicate STANDARD DOI",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Duplicado\",\n  \"paternalLastName\": \"Prueba\",\n  \"maternalLastName\": \"Prueba\",\n  \"doi\": \"{{standardDoi}}\",\n  \"doiType\": \"{{standardDoiType}}\",\n  \"birthDate\": \"01/01/1990\",\n  \"gender\": \"FEMALE\",\n  \"email\": \"duplicate.placeholder@example.test\",\n  \"phone\": \"016543210\",\n  \"mobilePhone\": \"912345678\",\n  \"profession\": \"Prueba\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/users",
            "description": "Precondición: el DOI debe existir. El comportamiento actual devuelve 400."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('Duplicate DOI is rejected', function () { pm.response.to.have.status(400); });"]
            }
          }]
        }
      ]
    }
  ]
}
