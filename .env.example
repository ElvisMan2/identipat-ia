# Perfil local. Spring Boot/Maven no carga este archivo automáticamente.
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL local (valores de ejemplo exclusivamente de desarrollo).
DB_NAME=identipatdb
DB_URL=jdbc:postgresql://localhost:5433/identipatdb
DB_USER=identipat_dev_user
DB_PASSWORD=dev_password_123

# Seguridad y servidor local.
JWT_SECRET=identipat-local-example-secret-change-me-32chars
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:4200
STANDARD_SESSION_PEPPER=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
STANDARD_SESSION_INACTIVITY_TIMEOUT=30m
STANDARD_SESSION_ABSOLUTE_TIMEOUT=8h
STANDARD_SESSION_COOKIE_SECURE=false
SERVER_PORT=8082
APP_TIME_ZONE=America/Lima

# IA generativa para DEV.
IDENTIPAT_AI_ENABLED=true
IDENTIPAT_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT=60s

# Cliente Java hacia el servicio Python interno.
PREPROCESSING_SERVICE_BASE_URL=http://localhost:8090
PREPROCESSING_SERVICE_CONNECT_TIMEOUT=5s
PREPROCESSING_PDF_TIMEOUT=15s
PREPROCESSING_AUDIO_TIMEOUT=300s
PREPROCESSING_AUDIO_READY_TIMEOUT_SECONDS=300

# Flujo durable de análisis (defaults técnicos DEV/TEST, no reglas institucionales).
ANALYSIS_TEXT_MIN_LENGTH=20
ANALYSIS_TEXT_MAX_LENGTH=20000
ANALYSIS_PDF_MAX_FILE_SIZE_BYTES=10485760
ANALYSIS_AUDIO_MAX_FILE_SIZE_BYTES=20971520
ANALYSIS_AUDIO_MAX_DURATION_SECONDS=180
ANALYSIS_MULTIPART_MAX_REQUEST_SIZE=21MB
ANALYSIS_PDF_MAX_PAGES=50
ANALYSIS_WORKER_ENABLED=true
ANALYSIS_POLL_INTERVAL=2s
ANALYSIS_WORKER_THREADS=2
ANALYSIS_WORKER_QUEUE_CAPACITY=2
ANALYSIS_LEASE_DURATION=120s
ANALYSIS_MAX_ATTEMPTS=2
ANALYSIS_RETRY_DELAY=5s
ANALYSIS_AI_MAX_OUTPUT_TOKENS=6000

# Admisión durable. El flag permite compatibilidad controlada en tests; no debe
# usarse para eludir cuotas en un ambiente abierto.
ANALYSIS_ADMISSION_ENABLED=true
ANALYSIS_STANDARD_MAX_PER_HOUR=3
ANALYSIS_STANDARD_MAX_PER_24H=10
ANALYSIS_STANDARD_AUDIO_MAX_PER_24H=3
ANALYSIS_STANDARD_MAX_ACTIVE=1
ANALYSIS_GLOBAL_MAX_ACTIVE=8
ANALYSIS_AUDIO_MAX_PREPROCESSING=1
ANALYSIS_ADMISSION_RESERVATION_TTL=8m
ANALYSIS_ADMISSION_RESERVATION_SAFETY_MARGIN=60s
ANALYSIS_ADMISSION_RETRY_AFTER=10s

# Idempotencia HTTP de análisis. El secreto es solo un ejemplo local; cada
# ambiente compartido debe inyectar uno propio, estable entre réplicas.
ANALYSIS_IDEMPOTENCY_REQUIRED=false
ANALYSIS_IDEMPOTENCY_MAX_KEY_LENGTH=64
ANALYSIS_IDEMPOTENCY_CLAIM_TTL=10m
ANALYSIS_IDEMPOTENCY_RETENTION=48h
ANALYSIS_IDEMPOTENCY_IN_PROGRESS_RETRY_AFTER=5s
ANALYSIS_IDEMPOTENCY_HMAC_SECRET=identipat-idempotency-local-secret-change-me

# Límites equivalentes al ejecutar preprocessing-service directamente.
PREPROCESSING_PDF_MAX_FILE_SIZE_BYTES=10485760
PREPROCESSING_PDF_MAX_PAGES=50
PREPROCESSING_AUDIO_MAX_FILE_SIZE_BYTES=20971520
PREPROCESSING_AUDIO_MAX_DURATION_SECONDS=180
PREPROCESSING_AUDIO_MODEL=base
PREPROCESSING_AUDIO_LANGUAGE=es
PREPROCESSING_AUDIO_DEVICE=cpu
PREPROCESSING_AUDIO_COMPUTE_TYPE=int8
PREPROCESSING_AUDIO_MODEL_CACHE_DIR=/models
PREPROCESSING_HF_HOME=/models/.huggingface

# Opcional: ubicaciones separadas por coma para recursos estáticos en DEV.
STATIC_LOCATIONS=classpath:/static/,file:../frontend/dist/identipat-ia/browser/

# Docker Compose / pgAdmin local.
PGADMIN_EMAIL=admin@example.local
PGADMIN_PASSWORD=change-me-local-only
